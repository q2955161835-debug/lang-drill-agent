{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lang Drill Agent",
  "version": "1.0.1",
  "identifier": "com.langdrill.agent",
  "build": {
    "beforeDevCommand": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../scripts/desktop/start-frontend-for-tauri.ps1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../scripts/desktop/build-frontend-for-tauri.ps1",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lang Drill Agent",
        "width": 1320,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/q2955161835-debug/lang-drill-agent/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM0OUJFMUMyMEUwMUY4RjUKUldUMStBRU93dUdiTlA2U1Jkb2lJNkR6TGtMbDdaSEZVNHlEaUNjSnRLSE9IUW1FSFduWFJEdjMK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "category": "Education",
    "icon": [
      "icons/icon.ico"
    ],
    "shortDescription": "English learning agent for CET practice",
    "longDescription": "Lang Drill Agent is a local-first language learning agent with chat, practice questions, screenshot import workflows, and a local SQLite learning database.",
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "resources": {
      "../backend/langdrill_agent/*.py": "app/backend/langdrill_agent/",
      "../backend/langdrill_agent/migrations/": "app/backend/langdrill_agent/migrations/",
      "../backend/langdrill_agent/past_papers/": "app/backend/langdrill_agent/past_papers/",
      "../backend/langdrill_agent/creative/": "app/backend/langdrill_agent/creative/",
      "../backend/langdrill_agent/knowledge/": "app/backend/langdrill_agent/knowledge/",
      "../backend/langdrill_agent/memory/": "app/backend/langdrill_agent/memory/",
      "../backend/langdrill_agent/routers/": "app/backend/langdrill_agent/routers/",
      "../backend/langdrill_agent/runtime/": "app/backend/langdrill_agent/runtime/",
      "../pyproject.toml": "app/pyproject.toml",
      "../scripts/desktop/start-backend.ps1": "desktop-runtime/start-backend.ps1",
      "../scripts/desktop/prepare-pi-runtime.ps1": "desktop-runtime/prepare-pi-runtime.ps1",
      "../scripts/desktop/install-pi-runtime.ps1": "desktop-runtime/install-pi-runtime.ps1",
      "../scripts/desktop/repair-pi-runtime.ps1": "desktop-runtime/repair-pi-runtime.ps1",
      "../runtime/pi-runtime-manifest.json": "desktop-runtime/pi-runtime-manifest.json",
      "../runtime/bundled-skills/": "desktop-runtime/bundled-skills/",
      "../runtime/pi-bridge/src/": "desktop-runtime/pi-bridge/src/",
      "../runtime/pi-bridge/test/": "desktop-runtime/pi-bridge/test/",
      "../runtime/pi-bridge/package.json": "desktop-runtime/pi-bridge/package.json",
      "../runtime/pi-bridge/package-lock.json": "desktop-runtime/pi-bridge/package-lock.json",
      "../runtime/pi-bridge/tsconfig.json": "desktop-runtime/pi-bridge/tsconfig.json",
      "../runtime/pi-bridge/vitest.config.ts": "desktop-runtime/pi-bridge/vitest.config.ts"
    }
  }
}
