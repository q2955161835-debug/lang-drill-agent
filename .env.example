# 真实密钥只允许写入 .env，本文件只保留占位值。
LANGDRILL_DB_PATH=./data/langdrill_agent.db
LANGDRILL_USER_NAME=boss
LANGDRILL_DEFAULT_PROVIDER=mock
LANGDRILL_DEFAULT_MODEL=mock-tutor-v1

# OpenAI-compatible（兼容 OpenAI 接口）供应商示例。
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Local OpenAI-compatible（本地 OpenAI 兼容）服务示例。
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=local-placeholder
LOCAL_LLM_MODEL=qwen2.5:7b

# 源 skill 目录，可用于导入考纲、真题索引和既有学习数据。
LANGDRILL_SKILL_SOURCE=D:/1Folder/语言学习-lang-drill/语言学习-lang-drill-skill
