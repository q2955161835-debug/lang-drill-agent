# 真实密钥只允许写入 .env，本文件只保留占位值。
LANGDRILL_USER_DATA_DIR=~/.langdrill-agent
LANGDRILL_DB_PATH=~/.langdrill-agent/data/langdrill_agent.db
LANGDRILL_LOG_LEVEL=INFO
LANGDRILL_USER_NAME=boss
LANGDRILL_ENABLE_LLMLINGUA=0
LANGDRILL_DEFAULT_PROVIDER=mock
LANGDRILL_DEFAULT_MODEL=mock-tutor-v1
LANGDRILL_PROVIDER_BASE_URL=https://api.example.com/v1
LANGDRILL_PROVIDER_API_KEY=provider-key-placeholder

# 默认四个内置供应商的 API Key（接口密钥）占位。
# 真实密钥只写入 .env；建议只填写纯密钥，不带 apikey:/Bearer: 等说明前缀。
# 快捷模型选择只显示已配置密钥且已启用的真实供应商。
LANGDRILL_PROVIDER_API_KEY_OPENAI=openai-key-placeholder
LANGDRILL_PROVIDER_API_KEY_CLAUDE=claude-key-placeholder
LANGDRILL_PROVIDER_API_KEY_DEEPSEEK=deepseek-key-placeholder
LANGDRILL_PROVIDER_API_KEY_MIMO=mimo-key-placeholder

# OpenAI-compatible（兼容 OpenAI 接口）供应商示例。
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Local OpenAI-compatible（本地 OpenAI 兼容）服务示例。
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=local-placeholder
LOCAL_LLM_MODEL=qwen2.5:7b

# 源 skill 目录，可用于导入考纲、真题索引和既有学习数据。
LANGDRILL_SKILL_SOURCE=D:/1Folder/语言学习-lang-drill/语言学习-lang-drill-skill
